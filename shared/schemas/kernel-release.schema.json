{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sate.local/schemas/kernel-release.schema.json",
  "title": "KERNEL-A release",
  "description": "Build-signed kernel artifact and the separate deploy authorization. The constitution key cannot sign either.",
  "$defs": {
    "manifest_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "payload_hash", "signature", "canonical", "manifest"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "canonical": { "type": "string", "minLength": 2 },
        "manifest": { "$ref": "#/$defs/manifest" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "group_id",
        "git_sha",
        "constitution_hash",
        "constitution_version",
        "binary_sha256",
        "built_at"
      ],
      "properties": {
        "artifact_id": { "const": "kernel-a" },
        "group_id": { "const": "A" },
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "constitution_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "constitution_version": { "type": "integer", "minimum": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "built_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "payload_hash", "signature", "canonical", "authorization"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "canonical": { "type": "string", "minLength": 2 },
        "authorization": { "$ref": "#/$defs/authorization_body" }
      }
    },
    "authorization_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "artifact_id",
        "group_id",
        "git_sha",
        "constitution_hash",
        "constitution_version",
        "binary_sha256",
        "authorized_at",
        "change_id",
        "reason",
        "safety_domains"
      ],
      "properties": {
        "action": { "enum": ["activate", "rollback"] },
        "artifact_id": { "const": "kernel-a" },
        "group_id": { "const": "A" },
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "constitution_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "constitution_version": { "type": "integer", "minimum": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authorized_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "change_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "safety_domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
